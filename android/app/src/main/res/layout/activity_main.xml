<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117"
    android:scrollbars="none"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Шапка -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp"
            android:paddingTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Отчёт МТС → ВК"
                android:textColor="#E6EDF3"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#8B949E"
                android:textSize="13sp"
                android:text="Напоминание выключено" />
        </LinearLayout>

        <!-- Главное действие -->
        <LinearLayout style="@style/Card">

            <Button
                android:id="@+id/sendNow"
                style="@style/BtnPrimary"
                android:text="Собрать и отправить отчёт" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="#8B949E"
                android:textSize="12sp"
                android:text="Соберёт показатели с портала и отправит их в чат ВК." />
        </LinearLayout>

        <!-- Куда отправлять -->
        <LinearLayout style="@style/Card">

            <TextView style="@style/CardTitle" android:text="КУДА ОТПРАВЛЯТЬ" />

            <TextView style="@style/Label" android:text="Чат ВК" />
            <EditText
                android:id="@+id/peer"
                style="@style/Input"
                android:hint="c66 или 2000000066"
                android:inputType="text" />

            <Button
                android:id="@+id/pickChat"
                style="@style/BtnSecondary"
                android:text="Выбрать чат из списка" />

            <TextView style="@style/Label" android:text="Домен ВК (vk.ru или vk.com)" />
            <EditText
                android:id="@+id/vkHost"
                style="@style/Input"
                android:hint="vk.ru"
                android:inputType="text" />

            <TextView style="@style/Label" android:text="Количество звонков за сегодня" />
            <EditText
                android:id="@+id/calls"
                style="@style/Input"
                android:hint="0"
                android:inputType="number" />
        </LinearLayout>

        <!-- Напоминание -->
        <LinearLayout style="@style/Card">

            <TextView style="@style/CardTitle" android:text="НАПОМИНАНИЕ" />

            <CheckBox
                android:id="@+id/enabled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Напоминать отправить отчёт"
                android:textColor="#E6EDF3" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#8B949E"
                android:textSize="12sp"
                android:text="В назначенное время придёт уведомление — нажмите его, и отчёт уйдёт." />

            <TextView style="@style/Label" android:text="Время напоминания" />
            <TimePicker
                android:id="@+id/time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:timePickerMode="spinner" />

            <Button
                android:id="@+id/testNotify"
                style="@style/BtnSecondary"
                android:text="Проверить напоминание" />

            <TextView style="@style/Label" android:text="Дни недели" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">
                <CheckBox android:id="@+id/d1" style="@style/Day" android:text="Пн" />
                <CheckBox android:id="@+id/d2" style="@style/Day" android:text="Вт" />
                <CheckBox android:id="@+id/d3" style="@style/Day" android:text="Ср" />
                <CheckBox android:id="@+id/d4" style="@style/Day" android:text="Чт" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <CheckBox android:id="@+id/d5" style="@style/Day" android:text="Пт" />
                <CheckBox android:id="@+id/d6" style="@style/Day" android:text="Сб" />
                <CheckBox android:id="@+id/d7" style="@style/Day" android:text="Вс" />
            </LinearLayout>
        </LinearLayout>

        <!-- Шаблон -->
        <LinearLayout style="@style/Card">

            <TextView style="@style/CardTitle" android:text="ШАБЛОН ОТЧЁТА" />

            <TextView style="@style/Label" android:text="{метки} подставляются с портала" />
            <EditText
                android:id="@+id/template"
                style="@style/Input"
                android:minLines="6"
                android:gravity="top"
                android:inputType="textMultiLine" />
        </LinearLayout>

        <!-- Вход -->
        <LinearLayout style="@style/Card">

            <TextView style="@style/CardTitle" android:text="ВХОД" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#8B949E"
                android:textSize="12sp"
                android:text="Достаточно войти один раз — сессии сохранятся." />

            <Button
                android:id="@+id/loginPortal"
                style="@style/BtnSecondary"
                android:text="Войти в портал МТС" />

            <Button
                android:id="@+id/loginVk"
                style="@style/BtnSecondary"
                android:text="Войти в ВК" />
        </LinearLayout>

        <Button
            android:id="@+id/save"
            style="@style/BtnPrimary"
            android:text="Сохранить настройки" />

        <TextView
            android:id="@+id/hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="8dp"
            android:textColor="#6E7A87"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp"
            android:text="Разрешите приложению «точные будильники» и «уведомления», иначе напоминание может не прийти вовремя." />

    </LinearLayout>
</ScrollView>
